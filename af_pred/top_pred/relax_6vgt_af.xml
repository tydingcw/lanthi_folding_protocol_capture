<ROSETTASCRIPTS>
    <SCOREFXNS>
	<ScoreFunction name="r15" weights="ref2015"/>
	<ScoreFunction name="r15_cst" weights="ref2015_cst"/>
	<ScoreFunction name="r15_coord" weights="ref2015_cst">
		<Reweight scoretype="coordinate_constraint" weight="1.0"/>
	</ScoreFunction>
        <ScoreFunction name="r15_cart" weights="ref2015_cart_cst"/>
    </SCOREFXNS>
    <RESIDUE_SELECTORS>
	<Index name="lan1" resnums="1,5"/> #9B,3B
	<Index name="ring1" resnums="1-5"/> #9B,3B
	<Index name="lan2" resnums="14,18"/> #13B,19B
	<Index name="ring2" resnums="14-18"/> #13B,19B
	<Index name="lan3" resnums="34,38"/> #13B,19B
	<Index name="ring3" resnums="34-38"/> #13B,19B
	<Index name="peptide" resnums="1-38"/> #1B,19B
	<Index name="seg1-17" resnums="1-5"/>
	<Index name="seg18-25" resnums="18-25"/>
	<Index name="seg26-38" resnums="26-38"/>
    </RESIDUE_SELECTORS>
    <PACKER_PALETTES>
    </PACKER_PALETTES>
    <TASKOPERATIONS>
	<IncludeCurrent name="incl_curr" />
	<RestrictToRepacking name="rtrp"/>
        <OperateOnResidueSubset name="no_repack_ring" selector="ring1 and ring2" >
            <PreventRepackingRLT />
        </OperateOnResidueSubset>
    </TASKOPERATIONS>
    <SIMPLE_METRICS>
        <RMSDMetric name="calc_rmsd_full" residue_selector="peptide" rmsd_type="rmsd_all_heavy" use_native="true" super="true"/>
        <RMSDMetric name="calc_rmsd_bb" residue_selector="peptide" rmsd_type="rmsd_protein_bb_heavy_including_O" use_native="true" super="true"/>
        <TotalEnergyMetric name="cst_eng" scorefxn="r15_cst" scoretype="atom_pair_constraint" />
        <TotalEnergyMetric name="eng_no_cst" scorefxn="r15" />
        <SasaMetric name="SASA" />
        <DihedralDistanceMetric name="ring1_dih" use_native="true" residue_selector="ring1"/>
        <TotalEnergyMetric name="ring1_eng" scorefxn="r15_cst" scoretype="total_score" residue_selector="ring1"/>
        <PeptideInternalHbondsMetric name="ring1_hbond" residue_selector="ring1"/>
        <TotalEnergyMetric name="ring1_nmr" scorefxn="r15_cst" scoretype="atom_pair_constraint" residue_selector="ring1"/>
        <RMSDMetric name="ring1_rmsd_full" residue_selector="ring1" rmsd_type="rmsd_all_heavy" use_native="true" super="true"/>
        <RMSDMetric name="ring1_rmsd_bb" residue_selector="ring1" rmsd_type="rmsd_protein_bb_heavy_including_O" use_native="true" super="true"/>
        <DihedralDistanceMetric name="ring2_dih" use_native="true" residue_selector="ring2"/>
        <TotalEnergyMetric name="ring2_eng" scorefxn="r15_cst" scoretype="total_score" residue_selector="ring2"/>
        <PeptideInternalHbondsMetric name="ring2_hbond" residue_selector="ring2"/>
        <TotalEnergyMetric name="ring2_nmr" scorefxn="r15_cst" scoretype="atom_pair_constraint" residue_selector="ring2"/>
        <RMSDMetric name="ring2_rmsd_full" residue_selector="ring2" rmsd_type="rmsd_all_heavy" use_native="true" super="true"/>
        <RMSDMetric name="ring2_rmsd_bb" residue_selector="ring2" rmsd_type="rmsd_protein_bb_heavy_including_O" use_native="true" super="true"/>
        <DihedralDistanceMetric name="ring3_dih" use_native="true" residue_selector="ring3"/>
        <TotalEnergyMetric name="ring3_eng" scorefxn="r15_cst" scoretype="total_score" residue_selector="ring3"/>
        <PeptideInternalHbondsMetric name="ring3_hbond" residue_selector="ring3"/>
        <TotalEnergyMetric name="ring3_nmr" scorefxn="r15_cst" scoretype="atom_pair_constraint" residue_selector="ring3"/>
        <RMSDMetric name="ring3_rmsd_full" residue_selector="ring3" rmsd_type="rmsd_all_heavy" use_native="true" super="true"/>
        <RMSDMetric name="ring3_rmsd_bb" residue_selector="ring3" rmsd_type="rmsd_protein_bb_heavy_including_O" use_native="true" super="true"/>
        <DihedralDistanceMetric name="seg1-17_dih" use_native="true" residue_selector="seg1-17"/>
        <TotalEnergyMetric name="seg1-17_eng" scorefxn="r15_cst" scoretype="total_score" residue_selector="seg1-17"/>
        <PeptideInternalHbondsMetric name="seg1-17_hbond" residue_selector="seg1-17"/>
        <TotalEnergyMetric name="seg1-17_nmr" scorefxn="r15_cst" scoretype="atom_pair_constraint" residue_selector="seg1-17"/>
        <RMSDMetric name="seg1-17_rmsd_full" residue_selector="seg1-17" rmsd_type="rmsd_all_heavy" use_native="true" super="true"/>
        <RMSDMetric name="seg1-17_rmsd_bb" residue_selector="seg1-17" rmsd_type="rmsd_protein_bb_heavy_including_O" use_native="true" super="true"/>
        <DihedralDistanceMetric name="seg18-25_dih" use_native="true" residue_selector="seg18-25"/>
        <TotalEnergyMetric name="seg18-25_eng" scorefxn="r15_cst" scoretype="total_score" residue_selector="seg18-25"/>
        <PeptideInternalHbondsMetric name="seg18-25_hbond" residue_selector="seg18-25"/>
        <TotalEnergyMetric name="seg18-25_nmr" scorefxn="r15_cst" scoretype="atom_pair_constraint" residue_selector="seg18-25"/>
        <RMSDMetric name="seg18-25_rmsd_full" residue_selector="seg18-25" rmsd_type="rmsd_all_heavy" use_native="true" super="true"/>
        <RMSDMetric name="seg18-25_rmsd_bb" residue_selector="seg18-25" rmsd_type="rmsd_protein_bb_heavy_including_O" use_native="true" super="true"/>
        <DihedralDistanceMetric name="seg26-38_dih" use_native="true" residue_selector="seg26-38"/>
        <TotalEnergyMetric name="seg26-38_eng" scorefxn="r15_cst" scoretype="total_score" residue_selector="seg26-38"/>
        <PeptideInternalHbondsMetric name="seg26-38_hbond" residue_selector="seg26-38"/>
        <TotalEnergyMetric name="seg26-38_nmr" scorefxn="r15_cst" scoretype="atom_pair_constraint" residue_selector="seg26-38"/>
        <RMSDMetric name="seg26-38_rmsd_full" residue_selector="seg26-38" rmsd_type="rmsd_all_heavy" use_native="true" super="true"/>
        <RMSDMetric name="seg26-38_rmsd_bb" residue_selector="seg26-38" rmsd_type="rmsd_protein_bb_heavy_including_O" use_native="true" super="true"/>
    </SIMPLE_METRICS>
    <FILTERS>
    </FILTERS>
    <MOVERS>
	<MutateResidue name="mutate1" target="1" new_res="DBR"/>
	<MutateResidue name="mutate2" target="5" new_res="CYS"/>
	<MutateResidue name="mutate3" target="2" new_res="DBU"/>
	<MutateResidue name="mutate4" target="10" new_res="DBU"/>
	<MutateResidue name="mutate5" target="15" new_res="DHA"/>
	<MutateResidue name="mutate6" target="30" new_res="DBU"/>
	<MutateResidue name="mutate7" target="34" new_res="DALA"/>
	<MutateResidue name="mutate8" target="38" new_res="CYS"/>
	<CrosslinkerMover name="cyclize1" linker_name="lanthionine"
        residue_selector="lan1" scorefxn="r15"
        filter_by_constraints_energy="false"
        filter_by_sidechain_distance="false"
        pack_and_minimize_linker_and_sidechains="true"
        />
	<CrosslinkerMover name="cyclize2" linker_name="lanthionine"
        residue_selector="lan2" scorefxn="r15_cst"
        filter_by_constraints_energy="false"
        filter_by_sidechain_distance="false"
        pack_and_minimize_linker_and_sidechains="true"
        />
	<CrosslinkerMover name="cyclize3" linker_name="lanthionine"
        residue_selector="lan3" scorefxn="r15_cst"
        filter_by_constraints_energy="false"
        filter_by_sidechain_distance="false"
        pack_and_minimize_linker_and_sidechains="true"
        />
	AddConstraintsToCurrentConformationMover name="add_cnst"/>
	<AddConstraints name="add_coord_cst">
		<CoordinateConstraintGenerator name="coord_cst" residue_selector="peptide" ca_only="true" sd="0.5"/> #0.5 is default
	</AddConstraints>
	FastRelax name="frlx" scorefxn="r15_cst" repeats="5" task_operations="incl_curr" />
        <FastRelax name="init_frlx" repeats="1" scorefxn="r15_cst" min_type="dfpmin" task_operations="incl_curr" />
        <FastRelax name="ring_frlx" repeats="2" scorefxn="r15_cst" min_type="dfpmin" task_operations="incl_curr" >
            <MoveMap name="shear_mm" >
                <Span begin="1" end="999" chi="0" bb="0" />
                <Span begin="1" end="5" chi="1" bb="1" />
            </MoveMap>
	</FastRelax>
	<RemoveConstraints name="rm_coord_cst" constraint_generators="coord_cst"/>
	<ConstraintSetMover name="add_nmr_cst" add_constraints="true" cst_file="6VGT_noe.cst"/>
	<ClearConstraintsMover name="rm_cst"/>
        <MinMover name="cart_min" cartesian="true" bondlength="0" bondangle="1" bb="false" omega="false" chi="true" scorefxn="r15_cart" />

    </MOVERS>
    <APPLY_TO_POSE>
    </APPLY_TO_POSE>
    <PROTOCOLS>
	<Add mover="mutate1" />
	<Add mover="mutate2" />
	<Add mover="mutate3" />
	<Add mover="mutate4" />
	<Add mover="mutate5" />
	<Add mover="mutate6" />
	<Add mover="mutate7" />
	<Add mover="mutate8" />
	Add mover="cyclize1" />
	<Add mover="cyclize2" />
	<Add mover="cyclize3" />
	<Add mover="add_coord_cst" />
	<Add mover="init_frlx" />
	<Add mover="rm_cst" />
	<Add mover="cyclize1" />
	Add mover="cyclize2" />
	Add mover="cyclize3" />
	<Add mover="add_coord_cst" />
	<Add mover="ring_frlx" />
	<Add mover="rm_cst" />
	<Add mover="cyclize1" />
	<Add mover="cyclize2" />
	<Add mover="cyclize3" />
	<Add mover="init_frlx" />
	<Add mover="rm_cst" />
        <Add mover="add_nmr_cst" />
        <Add metrics="cst_eng" labels="nmr_cst"/>
        <Add metrics="ring1_nmr,ring2_nmr,ring3_nmr" labels="ring1_nmr,ring2_nmr,ring3_nmr"/>
        <Add metrics="seg1-17_nmr" labels="seg1-17_nmr"/>
        <Add metrics="seg18-25_nmr" labels="seg18-25_nmr"/>
        <Add metrics="seg26-38_nmr" labels="seg26-38_nmr"/>
	<Add mover="rm_cst" />
	<Add mover="cyclize1"/>
	<Add mover="cyclize2"/>
	<Add mover="cyclize3" />
        <Add mover="cart_min" />
        <Add metrics="calc_rmsd_full" labels="rmsd_full"/>
        <Add metrics="calc_rmsd_bb" labels="rmsd_bb"/>
        <Add metrics="SASA" labels="SASA"/>
        <Add metrics="ring1_dih,ring1_eng,ring1_hbond,ring1_rmsd_full,ring1_rmsd_bb,ring2_dih,ring2_eng,ring2_hbond,ring2_rmsd_full,ring2_rmsd_bb,ring3_dih,ring3_eng,ring3_hbond,ring3_rmsd_full,ring3_rmsd_bb" labels="ring1_dih,ring1_eng,ring1_hbond,ring1_rmsd_full,ring1_rmsd_bb,ring2_dih,ring2_eng,ring2_hbond,ring2_rmsd_full,ring2_rmsd_bb,ring3_dih,ring3_eng,ring3_hbond,ring3_rmsd_full,ring3_rmsd_bb"/>
        <Add metrics="seg1-17_dih,seg1-17_eng,seg1-17_hbond,seg1-17_rmsd_full,seg1-17_rmsd_bb" labels="seg1-17_dih,seg1-17_eng,seg1-17_hbond,seg1-17_rmsd_full,seg1-17_rmsd_bb"/>
        <Add metrics="seg18-25_dih,seg18-25_eng,seg18-25_hbond,seg18-25_rmsd_full,seg18-25_rmsd_bb" labels="seg18-25_dih,seg18-25_eng,seg18-25_hbond,seg18-25_rmsd_full,seg18-25_rmsd_bb"/>
        <Add metrics="seg26-38_dih,seg26-38_eng,seg26-38_hbond,seg26-38_rmsd_full,seg26-38_rmsd_bb" labels="seg26-38_dih,seg26-38_eng,seg26-38_hbond,seg26-38_rmsd_full,seg26-38_rmsd_bb"/>
        <Add metrics="eng_no_cst" labels="eng_no_cst" />
    </PROTOCOLS>
    <OUTPUT scorefxn="r15_cst" />
</ROSETTASCRIPTS>
