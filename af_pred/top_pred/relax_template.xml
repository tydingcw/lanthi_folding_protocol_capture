<ROSETTASCRIPTS>
    <SCOREFXNS>
	<ScoreFunction name="r15" weights="ref2015"/>
	<ScoreFunction name="r15_cst" weights="ref2015_cst"/>
	<ScoreFunction name="r15_coord" weights="ref2015_cst">
		<Reweight scoretype="coordinate_constraint" weight="1.0"/>
	</ScoreFunction>
    </SCOREFXNS>
    <RESIDUE_SELECTORS>
	<Index name="lan1" resnums="9,3"/> #9B,3B
	<Index name="ring1" resnums="3-9"/> #9B,3B
	<Index name="lan2" resnums="13,19"/> #13B,19B
	<Index name="ring2" resnums="13-19"/> #13B,19B
	<Index name="linker" resnums="10-12"/>
	<Index name="peptide" resnums="1-19"/> #1B,19B
    </RESIDUE_SELECTORS>
    <PACKER_PALETTES>
    </PACKER_PALETTES>
    <TASKOPERATIONS>
	<IncludeCurrent name="incl_curr" />
    </TASKOPERATIONS>
    <SIMPLE_METRICS>
        <RMSDMetric name="calc_rmsd_full" residue_selector="peptide" rmsd_type="rmsd_all_heavy" use_native="true" super="true"/>
        <RMSDMetric name="calc_rmsd_bb" residue_selector="peptide" rmsd_type="rmsd_protein_bb_heavy_including_O" use_native="true" super="true"/>
        <TotalEnergyMetric name="cst_eng" scorefxn="r15_cst" scoretype="atom_pair_constraint" />
        <TotalEnergyMetric name="eng_no_cst" scorefxn="r15" />
        <SasaMetric name="SASA" />
        <DihedralDistanceMetric name="ring1_dih" use_native="true" residue_selector="ring1"/>
        <TotalEnergyMetric name="ring1_eng" scorefxn="r15" scoretype="total_score" residue_selector="ring1"/>
        <PeptideInternalHbondsMetric name="ring1_hbond" residue_selector="ring1"/>
        <TotalEnergyMetric name="ring1_nmr" scorefxn="r15_cst" scoretype="atom_pair_constraint" residue_selector="ring1"/>
        <RMSDMetric name="ring1_rmsd_full" residue_selector="ring1" rmsd_type="rmsd_all_heavy" use_native="true" super="true"/>
        <RMSDMetric name="ring1_rmsd_bb" residue_selector="ring1" rmsd_type="rmsd_protein_bb_heavy_including_O" use_native="true" super="true"/>
        <DihedralDistanceMetric name="ring2_dih" use_native="true" residue_selector="ring2"/>
        <TotalEnergyMetric name="ring2_eng" scorefxn="r15" scoretype="total_score" residue_selector="ring2"/>
        <PeptideInternalHbondsMetric name="ring2_hbond" residue_selector="ring2"/>
        <TotalEnergyMetric name="ring2_nmr" scorefxn="r15_cst" scoretype="atom_pair_constraint" residue_selector="ring2"/>
        <RMSDMetric name="ring2_rmsd_full" residue_selector="ring2" rmsd_type="rmsd_all_heavy" use_native="true" super="true"/>
        <RMSDMetric name="ring2_rmsd_bb" residue_selector="ring2" rmsd_type="rmsd_protein_bb_heavy_including_O" use_native="true" super="true"/>
        <DihedralDistanceMetric name="ring3_dih" use_native="true" residue_selector="ring3"/>
        <TotalEnergyMetric name="ring3_eng" scorefxn="r15" scoretype="total_score" residue_selector="ring3"/>
        <PeptideInternalHbondsMetric name="ring3_hbond" residue_selector="ring3"/>
        <TotalEnergyMetric name="ring3_nmr" scorefxn="r15_cst" scoretype="atom_pair_constraint" residue_selector="ring3"/>
        <RMSDMetric name="ring3_rmsd_full" residue_selector="ring3" rmsd_type="rmsd_all_heavy" use_native="true" super="true"/>
        <RMSDMetric name="ring3_rmsd_bb" residue_selector="ring3" rmsd_type="rmsd_protein_bb_heavy_including_O" use_native="true" super="true"/>
        <DihedralDistanceMetric name="ring4_dih" use_native="true" residue_selector="ring4"/>
        <TotalEnergyMetric name="ring4_eng" scorefxn="r15" scoretype="total_score" residue_selector="ring4"/>
        <PeptideInternalHbondsMetric name="ring4_hbond" residue_selector="ring4"/>
        <TotalEnergyMetric name="ring4_nmr" scorefxn="r15_cst" scoretype="atom_pair_constraint" residue_selector="ring4"/>
        <RMSDMetric name="ring4_rmsd_full" residue_selector="ring4" rmsd_type="rmsd_all_heavy" use_native="true" super="true"/>
        <RMSDMetric name="ring4_rmsd_bb" residue_selector="ring4" rmsd_type="rmsd_protein_bb_heavy_including_O" use_native="true" super="true"/>
    </SIMPLE_METRICS>
    <FILTERS>
    </FILTERS>
    <MOVERS>
	<CrosslinkerMover name="cyclize1" linker_name="lanthionine"
        residue_selector="lan1" scorefxn="r15"
        filter_by_constraints_energy="false"
        filter_by_sidechain_distance="false"
        pack_and_minimize_linker_and_sidechains="true"
        />
	<CrosslinkerMover name="cyclize2" linker_name="lanthionine"
        residue_selector="lan2" scorefxn="r15_cst"
        filter_by_constraints_energy="false"
        filter_by_sidechain_distance="false"
        pack_and_minimize_linker_and_sidechains="true"
        />
	AddConstraintsToCurrentConformationMover name="add_cnst"/>
	<AddConstraints name="add_coord_cst">
		<CoordinateConstraintGenerator name="coord_cst" residue_selector="peptide"/>
	</AddConstraints>
	FastRelax name="frlx" scorefxn="r15_cst" repeats="5" task_operations="incl_curr" />
        <FastRelax name="init_frlx" repeats="5" scorefxn="r15_coord" min_type="dfpmin"
            task_operations="incl_curr" />
	<RemoveConstraints name="rm_coord_cst" constraint_generators="coord_cst"/>
	<ClearConstraintsMover name="rm_cst"/>
    </MOVERS>
    <APPLY_TO_POSE>
    </APPLY_TO_POSE>
    <PROTOCOLS>
	<Add mover="cyclize1" />
	<Add mover="cyclize2" />
	<Add mover="add_coord_cst" />
	<Add mover="init_frlx" />
	<Add mover="rm_cst" />
	<Add mover="cyclize1"/>
	<Add mover="cyclize2"/>
    </PROTOCOLS>
    <OUTPUT scorefxn="r15_cst" />
</ROSETTASCRIPTS>
