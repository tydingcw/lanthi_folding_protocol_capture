<ROSETTASCRIPTS>
    <SCOREFXNS>
	<ScoreFunction name="r15" weights="ref2015"/>
	<ScoreFunction name="r15_cst" weights="ref2015_cst"/>
	<ScoreFunction name="r15_coord" weights="ref2015_cst">
		<Reweight scoretype="coordinate_constraint" weight="1.0"/>
		Reweight scoretype="omega" weight="40.0"/>
        	<Reweight scoretype="chainbreak" weight="40.0" />
        	Reweight scoretype="fa_rep" weight="10.0" />
		Reweight scoretype="rama_prepro" weight="10.0"/>
	</ScoreFunction>
	<ScoreFunction name="15_rama" weights="ref2015_cst">
		Reweight scoretype="rama_prepro" weight="10.0"/>
        	<Reweight scoretype="chainbreak" weight="40.0" />
	</ScoreFunction>
	<ScoreFunction name="score3" weights="score3" symmetric="0">
		<Reweight scoretype="dihedral_constraint" weight="1.0" />
		<Reweight scoretype="atom_pair_constraint" weight="10" />
		<Reweight scoretype="cen_hb" weight="1.0" />
		<Reweight scoretype="rama_prepro" weight="2.0"/>#added
	</ScoreFunction>
	<ScoreFunction name="score4" weights="score4_smooth_cart" symmetric="0">
		<Reweight scoretype="cart_bonded" weight="0.5" />
		<Reweight scoretype="dihedral_constraint" weight="0.1" />
		<Reweight scoretype="atom_pair_constraint" weight="1" />
		<Reweight scoretype="cen_hb" weight="1.0" />
		<Reweight scoretype="rama_prepro" weight="2.0"/>#added
	</ScoreFunction>
        <ScoreFunction name="r15_cart" weights="ref2015_cart_cst"/>
    </SCOREFXNS>
