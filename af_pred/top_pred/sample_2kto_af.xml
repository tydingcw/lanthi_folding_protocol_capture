        <DihedralDistanceMetric name="seg6-22_dih" use_native="true" residue_selector="seg6-22"/>
        <TotalEnergyMetric name="seg6-22_eng" scorefxn="r15_cst" scoretype="total_score" residue_selector="seg6-22"/>
