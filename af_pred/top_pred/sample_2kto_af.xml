	MutateResidue name="mutate11" target="28" new_res="BDR"/>
	<CrosslinkerMover name="cyclize1" linker_name="lanthionine"
        residue_selector="lan1" scorefxn="r15"
        filter_by_constraints_energy="false"
        filter_by_sidechain_distance="false"
        pack_and_minimize_linker_and_sidechains="true"
        />
	<CrosslinkerMover name="cyclize2" linker_name="lanthionine"
        residue_selector="lan2" scorefxn="r15_cst"
        filter_by_constraints_energy="false"
        filter_by_sidechain_distance="false"
        pack_and_minimize_linker_and_sidechains="true"
        />
	<CrosslinkerMover name="cyclize3" linker_name="lanthionine"
        residue_selector="lan3" scorefxn="r15_cst"
        filter_by_constraints_energy="false"
        filter_by_sidechain_distance="false"
        pack_and_minimize_linker_and_sidechains="true"
        />
	<CrosslinkerMover name="cyclize4" linker_name="lanthionine"
        residue_selector="lan4" scorefxn="r15_cst"
        filter_by_constraints_energy="false"
        filter_by_sidechain_distance="false"
        pack_and_minimize_linker_and_sidechains="true"
        />
	AddConstraintsToCurrentConformationMover name="add_cnst"/>
	<AddConstraints name="add_coord_cst">
		<CoordinateConstraintGenerator name="coord_cst" residue_selector="center" ca_only="true" sd="0.5"/> #0.5 is default
	</AddConstraints>
	FastRelax name="frlx" scorefxn="r15_cst" repeats="5" task_operations="incl_curr" />
        <FastRelax name="init_frlx" repeats="3" scorefxn="r15_cst" min_type="dfpmin" task_operations="incl_curr" />
	<RemoveConstraints name="rm_coord_cst" constraint_generators="coord_cst"/>
	<ConstraintSetMover name="add_nmr_cst" add_constraints="true" cst_file="2KTO_noe.cst"/>
	<ConstraintSetMover name="add_link_cst" add_constraints="true" cst_file="2KTO_link.cst"/>

	<ClearConstraintsMover name="rm_cst"/>
	<ModifyVariantType name="rem_nterm" remove_type="LOWER_TERMINUS_VARIANT" residue_selector="start" update_polymer_bond_dependent_atoms="true" /> #NtermProteinFull
	<ModifyVariantType name="norm_nterm" add_type="LOWER_TERMINUS_VARIANT" residue_selector="start" update_polymer_bond_dependent_atoms="true" /> #NtermProteinFull
	ModifyVariantType name="nterm" add_type="N_ACETYLATION" residue_selector="start" update_polymer_bond_dependent_atoms="true" />
	<ModifyVariantType name="nterm" add_type="NTERM2_OXOBUTRYLATION" residue_selector="start" update_polymer_bond_dependent_atoms="true" />
	<ModifyVariantType name="nterm_res" remove_type="NTERM2_OXOBUTRYLATION" residue_selector="start" update_polymer_bond_dependent_atoms="true" />
	MutateResidue name="mut" residue_selector="start" new_res="DBU" mutate_self="true" />
        <RandomizeBBByRamaPrePro name="ramarand_upper" residue_selector="upper"/>
        <RandomizeBBByRamaPrePro name="ramarand_start" residue_selector="start_seg"/>
        <RandomizeBBByRamaPrePro name="ramarand_lower" residue_selector="lower"/>
        <RandomizeBBByRamaPrePro name="ramarand_ring3" residue_selector="ring3"/>
        <RandomizeBBByRamaPrePro name="ramarand_ring4" residue_selector="ring4"/>
        <FastRelax name="ring_frlx" repeats="3" scorefxn="r15_cst" min_type="dfpmin" task_operations="incl_curr" >
            <MoveMap name="shear_mm" >
                <Span begin="1" end="999" chi="0" bb="0" />
                <Span begin="1" end="7" chi="1" bb="1" />
                Span begin="8" end="22" chi="0" bb="0" />
                Span begin="29" end="30" chi="1" bb="0" />
                <Span begin="18" end="31" chi="1" bb="1" />
            </MoveMap>
	</FastRelax>

    Defines the base mover for small fragments (typically 3-mers)
    <SingleFragmentMover name="sfm_small" fragments="frags/2KTOA_frags.200.3mers" policy="smooth">
            <MoveMap >
                <Span begin="1" end="999" chi="0" bb="0" />
                <Span begin="1" end="8" chi="1" bb="1" />
                <Span begin="22" end="31" chi="1" bb="1" />
                Span begin="1" end="31" chi="1" bb="1" />
            </MoveMap>
    </SingleFragmentMover>

    Defines the base mover for large fragments (typically 9-mers)
    <SingleFragmentMover name="sfm_large" fragments="frags/2KTOA_frags.200.5mers" policy="uniform">
            <MoveMap >
                <Span begin="1" end="999" chi="0" bb="0" />
                <Span begin="22" end="31" chi="1" bb="1" />
                <Span begin="1" end="8" chi="1" bb="1" />
                Span begin="1" end="31" chi="1" bb="1" />
            </MoveMap>
    </SingleFragmentMover>

	<PDBTrajectoryRecorder name="record_pdb1" stride="10" filename="2KTO_traj1.pdb" cumulate_jobs="0" cumulate_replicas="0"/>
	<PDBTrajectoryRecorder name="record_pdb2" stride="10" filename="2KTO_traj2.pdb" cumulate_jobs="0" cumulate_replicas="0"/>
	<PDBTrajectoryRecorder name="record_pdb3" stride="10" filename="2KTO_traj3.pdb" cumulate_jobs="0" cumulate_replicas="0"/>
	<PDBTrajectoryRecorder name="record_pdb4" stride="10" filename="2KTO_traj4.pdb" cumulate_jobs="0" cumulate_replicas="0"/>
        <ParsedProtocol name="frag_steps1">
                <Add mover_name="record_pdb1"/>
                <Add mover_name="sfm_large"/>
        </ParsedProtocol>
	<GenericMonteCarlo name="stage3"  scorefxn_name="score3" mover_name="frag_steps1" temperature="2.0" trials="2000" recover_low="1" />
	
        <ParsedProtocol name="frag_steps2">
                <Add mover_name="record_pdb2"/>
                <Add mover_name="sfm_small"/>
        </ParsedProtocol>
	<GenericMonteCarlo name="stage4"  scorefxn_name="score4" mover_name="frag_steps2" temperature="2.0" trials="4000" recover_low="1" />

	<SwitchResidueTypeSetMover name="fullatom" set="fa_standard" />

	<Backrub name="bbmover" preserve_detailed_balance="1" require_mm_bend="0"/>
        <Sidechain name="sidechain" preserve_detailed_balance="1" task_operations="rtrp" prob_withinrot="0.5" prob_uniform="0.2"/>
	<Small name="small" scorefxn="r15_cst" temperature="0.6" nmoves="1" angle_max="50.0" preserve_detailed_balance="1">
            <MoveMap >
                <Span begin="1" end="999" chi="0" bb="0" />
                <Span begin="23" end="24" chi="1" bb="1" />
                <Span begin="27" end="28" chi="1" bb="1" />
            </MoveMap>
	</Small>
	<Shear name="shear" scorefxn="r15_cst" temperature="0.6" nmoves="1" angle_max="6.0" preserve_detailed_balance="1">
            <MoveMap >
                <Span begin="1" end="999" chi="0" bb="0" />
                #Span begin="22" end="6" chi="1" bb="1" />
                Span begin="1" end="8" chi="1" bb="1" />
                <Span begin="1" end="31" chi="1" bb="1" />
            </MoveMap>
	</Shear>
	<ParsedProtocol name="mc_steps">
                Add mover_name="record_pdb3"/>
                Add mover_name="bbmover"/>
                <Add mover_name="shear"/>
                <Add mover_name="sidechain"/>
        </ParsedProtocol>
	<ParsedProtocol name="mc_samp_steps">
                <Add mover_name="record_pdb3"/>
                Add mover_name="bbmover"/>
                <Add mover_name="small"/>
                <Add mover_name="sidechain"/>
        </ParsedProtocol>
	<GenericMonteCarlo name="mc_refine"  scorefxn_name="r15_cst" mover_name="mc_steps" drift="true" temperature="2.0" trials="5000" recover_low="1" />
	<GenericMonteCarlo name="mc_samp"  scorefxn_name="r15_cst" mover_name="mc_samp_steps" drift="true" temperature="2.0" trials="500" recover_low="1" />

        <SetTorsion name="init_tors">
            <Torsion residue="23" torsion_name="omega" angle="180.0" />
            <Torsion residue="24" torsion_name="omega" angle="180.0" />
            Torsion residue="pick_atoms" angle="0.0" >
		Atom1 residue="23" atom="O" />
		Atom1 residue="23" atom="C" />
		Atom1 residue="24" atom="N" />
		Atom1 residue="24" atom="CA" />
            /Torsion>
        </SetTorsion>

        <DeclareBond name="bond1" atom1="N" res1="24" atom2="C" res2="23" 
            add_termini="true"
        />
        <DeclareBond name="bond2" atom1="N" res1="15" atom2="C" res2="14" 
            add_termini="true"
        />
        <AtomTree name="foldtree" fold_tree_file="foldtree/2kto_tree.txt" />

	<GenericMonteCarlo name="ring1_samp"  scorefxn_name="r15_cst" mover_name="ramarand_lower" temperature="2.0" trials="100" recover_low="1" />
	<GenericMonteCarlo name="ring3_samp"  scorefxn_name="r15_cst" mover_name="ramarand_ring3" temperature="2.0" trials="1000" recover_low="1" />
	<GenericMonteCarlo name="ring4_samp"  scorefxn_name="r15_cst" mover_name="ramarand_ring4" temperature="2.0" trials="1000" recover_low="1" />
	<GenericMonteCarlo name="start_samp"  scorefxn_name="r15_cst" mover_name="ramarand_start" temperature="2.0" trials="100" recover_low="1" />
        <MinMover name="cart_min" cartesian="true" bondlength="0" bondangle="1" bb="false" omega="false" chi="true" scorefxn="r15_cart" />
	
    </MOVERS>
