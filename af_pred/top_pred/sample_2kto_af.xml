    </FILTERS>
    <MOVERS>
	<MutateResidue name="mutate1" target="1" new_res="DBU"/>
	<MutateResidue name="mutate1_1" target="1" new_res="GLY"/>
	<MutateResidue name="mutate2" target="4" new_res="DBU"/>
	<MutateResidue name="mutate2_1" target="4" new_res="GLY"/>
